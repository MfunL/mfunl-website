# ================================================================
# ROOT .htaccess — makes /public act as the site's document root
# without changing the hosting panel's document root setting.
#
# Deploy this whole project (app/, config/, database/, public/,
# storage/, vendor_autoload.php, this file) directly into
# public_html/ as-is. Every request gets routed into public/, which
# keeps its own front-controller .htaccess for the app itself.
# ================================================================

# ---- Block direct access to non-web-facing folders ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|database|storage)(/.*)?$ - [F,L]
</IfModule>

# ---- Block direct access to sensitive root files ----
<FilesMatch "^(\.env(\.example)?|vendor_autoload\.php|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---- Route everything else through /public ----
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
